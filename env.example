# Hosted server only: copy to .env. Node.js 22.12+ is required.
# The default local commands ignore this file. See docs/HOSTED.md.
PORT=3000
HOST=127.0.0.1

# Development uses the Vite origin. Production requires the public HTTPS origin.
APP_ORIGIN=http://127.0.0.1:5173
# Defaults to APP_ORIGIN + /api/auth/callback; register that exact URL with OpenAI.
# OPENAI_REDIRECT_URI=https://language.bdamokos.org/api/auth/callback

# Leave empty for direct access. Behind a proxy, allow only its actual peer IP/CIDR.
# For Node behind a same-host proxy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# In Docker, the peer may be the bridge gateway instead; verify it before allowing.
TRUSTED_PROXY_CIDRS=

# Approved hosted client with ChatGPT plan usage, not an API key.
OPENAI_CLIENT_ID=
# Use the method OpenAI provisions: none or client_secret_basic.
OPENAI_TOKEN_AUTH_METHOD=none
# Confidential clients only; keep exclusively on the server.
OPENAI_CLIENT_SECRET=

# Private storage outside the static site. One process per storage pair.
AUTH_DIR=.auth
CACHE_DIR=.cache

# Optional deploy.sh settings.
REMOTE_HOST=
REMOTE_USER=bence
DEPLOY_PATH=/home/bence/language-ai-app
DEPLOY_PORT=3499
CACHE_HOST_DIR=/var/lib/language-ai-app
IMAGE_NAME=language-ai-app
IMAGE_TAG=latest
REGISTRY_HOST=
REGISTRY_PORT=5010
